--- a/verl/utils/megatron_utils.py
+++ b/verl/utils/megatron_utils.py
@@ -797,6 +797,58 @@ def load_megatron_model_to_gpu(models, load_grad=True, load_frozen_params=True):
     get_torch_device().empty_cache()
 
 
+def megatron_footprint(models, optimizer=None) -> dict:
+    """[gpu-mem experiment] Bytes of the offloadable Megatron state by location.
+
+    Walks exactly the objects the offload helpers touch: DDP param/grad buffers
+    (dense + expert), the pinned cpu_data copies, the distributed optimizer's
+    fp32 main-param shards and the (hybrid-device) optimizer state tensors.
+    Returns gpu_resident_* / cpu_resident_* byte counts per category.
+    """
+    cats = ("params", "grads", "main_params", "opt_state")
+    gpu = dict.fromkeys(cats, 0)
+    cpu = dict.fromkeys(cats, 0)
+
+    def add(t, cat):
+        if not isinstance(t, torch.Tensor):
+            return
+        n = t.untyped_storage().nbytes()
+        (cpu if t.device.type == "cpu" else gpu)[cat] += n
+
+    for model_chunk in models:
+        if isinstance(model_chunk, DDP):
+            for buffers in (model_chunk.buffers, model_chunk.expert_parallel_buffers):
+                for buffer in buffers:
+                    add(buffer.param_data, "params")
+                    add(getattr(buffer.param_data, "cpu_data", None), "params")
+                    add(buffer.grad_data, "grads")
+            for param in model_chunk.module.parameters():
+                if not param.requires_grad:
+                    add(param.data, "params")
+        else:
+            for param in model_chunk.parameters():
+                add(param.data, "params")
+                add(param.grad, "grads")
+
+    if optimizer is not None:
+        opts = optimizer.chained_optimizers if isinstance(optimizer, ChainedOptimizer) else [optimizer]
+        for opt in opts:
+            for group in getattr(opt, "shard_fp32_from_float16_groups", None) or []:
+                for t in group if isinstance(group, list) else [group]:
+                    add(t, "main_params")
+            inner = getattr(opt, "optimizer", None)
+            if inner is not None:
+                subs = getattr(inner, "sub_optimizers", None) or [inner]
+                for sub in subs:
+                    for state in getattr(sub, "state", {}).values():
+                        for v in state.values():
+                            add(v, "opt_state")
+
+    out = {f"gpu_resident_{k}": v for k, v in gpu.items()}
+    out.update({f"cpu_resident_{k}": v for k, v in cpu.items()})
+    return out
+
