         actor_rollout_resource_pool = self.resource_pool_manager.get_resource_pool(actor_role)
+        # [gpu-mem experiment] RLBENCH_NO_HYBRID_ROLLOUT=1: clean disaggregated layout, no
+        # hybrid vLLM replicas on the trainer GPUs. Workers get role "actor" so they build no
+        # ServerAdapter (engine_workers: `if "rollout" in self.role`).
+        no_hybrid_rollout = os.environ.get("RLBENCH_NO_HYBRID_ROLLOUT") == "1"
+        if no_hybrid_rollout:
+            assert actor_role == Role.ActorRollout, "RLBENCH_NO_HYBRID_ROLLOUT needs a config without reference policy"
         actor_rollout_cls = RayClassWithInitArgs(
             cls=self.role_worker_mapping[actor_role],
             config=self.config.actor_rollout_ref,
             distillation_config=self.config.get("distillation"),
-            role=str(actor_role),
+            role="actor" if no_hybrid_rollout else str(actor_role),
         )
         self.resource_pool_to_cls[actor_rollout_resource_pool][str(actor_role)] = actor_rollout_cls
 
