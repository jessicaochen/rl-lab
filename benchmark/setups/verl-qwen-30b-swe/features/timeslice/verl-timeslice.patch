diff --git a/verl/utils/gpu_mem_log.py b/verl/utils/gpu_mem_log.py
new file mode 100644
index 0000000..f6c3198
--- /dev/null
+++ b/verl/utils/gpu_mem_log.py
@@ -0,0 +1,96 @@
+# Instrumentation for rl-lab gpu-host-offload and timeslicing-multi-gpu experiments.
+# One-line GPU + host memory snapshots printed around every GPU<->host move,
+# on every rank. Lines start with "[gpu-mem]" and are parsed by report.py.
+import os
+import socket
+import sys
+
+import psutil
+import torch
+
+for _extra_path in ("/opt/verl", "/etc/rlbench/timeslice", "/data/timeslice"):
+    if os.path.isdir(_extra_path) and _extra_path not in sys.path:
+        sys.path.insert(0, _extra_path)
+
+from timeslice import (  # noqa: E402
+    DualPoolRoleLocks,
+    OffloadProxy,
+    OffloadProxySet,
+    OffloadSpec,
+    RankFanout,
+    RoleLockConfig,
+    TimeSliceOrchestratorClient,
+    WorkloadHandle,
+    format_offload_event,
+    format_restore_event,
+    install_verl_offload,
+    register_workload,
+    spawn_offload_proxies,
+)
+
+__all__ = [
+    "DualPoolRoleLocks",
+    "GB",
+    "OffloadProxy",
+    "OffloadProxySet",
+    "OffloadSpec",
+    "RankFanout",
+    "RoleLockConfig",
+    "TimeSliceOrchestratorClient",
+    "WorkloadHandle",
+    "emit",
+    "format_offload_event",
+    "format_restore_event",
+    "install_verl_offload",
+    "register_workload",
+    "snapshot",
+    "spawn_offload_proxies",
+]
+
+GB = 1024**3
+
+
+def snapshot() -> dict:
+    """GPU (allocator + device-level) and host (process + system) memory, in GB."""
+    torch.cuda.synchronize()
+    free, total = torch.cuda.mem_get_info()
+    proc = psutil.Process()
+    return {
+        "gpu_allocated_gb": torch.cuda.memory_allocated() / GB,
+        "gpu_reserved_gb": torch.cuda.memory_reserved() / GB,
+        "gpu_device_used_gb": (total - free) / GB,
+        "gpu_device_total_gb": total / GB,
+        "host_rss_gb": proc.memory_info().rss / GB,
+        "host_used_gb": psutil.virtual_memory().used / GB,
+    }
+
+
+def _rank() -> int:
+    try:
+        import torch.distributed as dist
+
+        if dist.is_available() and dist.is_initialized():
+            return dist.get_rank()
+    except Exception:
+        pass
+    return int(os.environ.get("RANK", -1))
+
+
+def emit(role: str, point: str, event: str, snap: dict, seconds: float | None = None, rank=None, **extra) -> None:
+    job_id = os.environ.get("TIMESLICE_JOB_ID", os.environ.get("JOB_ID", "job1"))
+    fields = [
+        "[gpu-mem]",
+        f"job_id={job_id}",
+        f"role={role}",
+        f"rank={_rank() if rank is None else rank}",
+        f"host={socket.gethostname()}",
+        f"pid={os.getpid()}",
+        f"point={point}",
+        f"event={event}",
+    ]
+    fields += [f"{k}={v:.3f}" for k, v in snap.items()]
+    if seconds is not None:
+        fields.append(f"seconds={seconds:.3f}")
+    fields += [f"{k}={v}" for k, v in extra.items()]
+    print(" ".join(fields), flush=True)


log_gpu_memory_usage = emit
