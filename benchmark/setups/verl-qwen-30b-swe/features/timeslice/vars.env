# Render-time variables for the timeslice feature (env < vars.env < --var).
# Coordinates multi-GPU trainer pool via llm-d-rl-time-slicing (verl-app-channel-offload).
TIMESLICE_ENABLED=1
TIMESLICE_TRAINER_ENABLED=1
TIMESLICE_SAMPLER_ENABLED=0
TIMESLICE_APP_OFFLOAD=1
VERL_TRAINER_POST_SYNC_OFFLOAD=0
VERL_SAMPLER_SLEEP_OFFLOAD=0
TIMESLICE_ORCHESTRATOR_ADDR=timeslice-timesliceorchestrator.timeslice-system.svc.cluster.local:50051
TIMESLICE_TRAINER_GROUP=trainers
TIMESLICE_SAMPLER_GROUP=samplers
TIMESLICE_MODE=app
JOB_ID=job1
ROLLOUT_GPU_MEM_UTIL=0.80
NO_HYBRID_ROLLOUT=1
TRAINER_REPLICAS=1
TRAINER_RAY_GPUS=8
ROLLOUT_RAY_GPUS=1
HEAD_CPU_REQ=4
HEAD_MEM_REQ=16Gi
WORKER_CPU_REQ=48
WORKER_MEM_REQ=700Gi
TRAINER_GPU_REQ=
TRAINER_GPU_LIM=
TRAINER_CONTAINER_CLAIMS=[{name: gpu}]
TRAINER_POD_CLAIMS=[{name: gpu, resourceClaimName: shared-trainers-gpu-claim}]
SAMPLER_GPU_REQ=nvidia.com/gpu: 1
SAMPLER_GPU_LIM=nvidia.com/gpu: 1
SAMPLER_CONTAINER_CLAIMS=[]
SAMPLER_POD_CLAIMS=[]
