# Render-time variables of the app-offload feature (env < vars.env < --var).
# Values are taken verbatim by rlbench: no inline comments, no quoting.
# The controller never changes verl settings; these only shape when and how long it acts.
# trainer: seconds params stay offloaded in each post-sync idle gap before the external reload
APP_OFFLOAD_TRAINER_HOLD_S=180
# sampler: seconds the engine stays asleep in each controller-made pause
APP_OFFLOAD_SAMPLER_HOLD_S=60
# controller-made sampler pauses per weight sync. 0 = trainer only (default since R1 2026-10-08:
# the sampler path's sleep/wake through __ray_call__ does not work; see the feature README)
APP_OFFLOAD_SAMPLER_CYCLES_PER_STEP=0
# start a sampler pause only this long after a weight sync finished
APP_OFFLOAD_SAMPLER_AFTER_SYNC_S=20
# state-API poll interval and how long the trainer must show no running verl task before a gap counts
APP_OFFLOAD_POLL_S=1
APP_OFFLOAD_SETTLE_S=3
# 1 = probe, detect gaps and log, but never call offload/sleep
APP_OFFLOAD_DRY_RUN=0
