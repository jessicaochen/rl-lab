# Render-time variables of the inference-scheduler feature (env < vars.env < --var).
# Scheduler profile file, relative to this feature's config/ dir:
#   scheduler-prefix.yaml        prefix_cache only — the upstream A/B treatment (default)
#   scheduler-backpressure.yaml  the repo's verl example (load scorers + prefix)
# Override with `--var SCHEDULER_CONFIG=<file>` after adding the file to config/.
SCHEDULER_CONFIG=scheduler-prefix.yaml
